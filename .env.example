# Copy this file to .env.local for local development.
# Never put real secrets in git, in the UI, or in logs.
# Leave every real-mode variable unset to run DEMO MODE.

# Public URL of this app. Used for the Asana OAuth redirect
# (APP_BASE_URL + /api/asana/oauth/callback) and same-origin checks.
APP_BASE_URL=http://localhost:3000

# Optional path to the SQLite file. Default: ./data/app.sqlite
# DATABASE_PATH=./data/app.sqlite

# --- Real mode (all five are required; otherwise the app fails closed) ---
# Create a private unpublished app in the Asana developer console:
# https://app.asana.com/0/my-apps
# Redirect URL: http://localhost:3000/api/asana/oauth/callback
# Request only least-privilege scopes listed in the README.
# ASANA_CLIENT_ID=
# ASANA_CLIENT_SECRET=

# 32-byte keys as 64 hex characters. Generate locally, for example:
#   openssl rand -hex 32
# TOKEN_ENCRYPTION_KEY=
# SESSION_SECRET=

# Hard allow-list of Asana workspace GIDs (comma-separated).
# Real writes are refused outside this list.
# ASANA_ALLOWED_WORKSPACE_GID=
